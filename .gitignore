# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.*

# Editor/IDE
.idea/
.vscode/

# OS-specific
.DS_Store
Thumbs.db

# Logs & temp files
*.log
*.tmp
tmp/
temp/

# Build outputs
/caddy
/caddy.exe
/caddy_*
/bin/
/dist/

# Generated test configs (created by run-integration-test.ps1)
tests/Caddyfile.test
Caddyfile.individual
Caddyfile.wildcard
Caddyfile.test
/build/
/out/

# caddy test files
/caddy-test/
/cmd/
tests/Caddyfile.cert
tests/Caddyfile.dynip
tests/Caddyfile.single
tests/Caddyfile.staging
tests/Caddyfile.wildcard-sub
tests/Caddyfile.wildcard-subsub
tests/Caddyfile.wildcard-test
tests/integration_test.go
tests/run-integration-test.ps1

# Local main wrapper (keep out of git)
/cmd/caddy-ipv64/

# Optional: local Caddy runtime data if created inside repo (usually outside)
autosave.json
.caddy/

# Local knowledge files (NOT committed to git - local reference only)
LOCAL_KNOWLEDGE.md
LOCAL_TIPS.md

# Additional non-tracked files
*.local
.env.local
config.local*
.github/copilot-instructions.md
tests/Caddyfile.dynip-test
tests/Caddyfile.lifecycle
tests/make_short_cert.go
tests/run-lifecycle-test.ps1
.github/workflows/ci.yml
